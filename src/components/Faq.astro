---
interface Props { faqs: { q: string; a: string }[]; title?: string }
const { faqs, title = 'Questions' } = Astro.props;
---
<section class="section faq">
  <div class="sec-head"><p class="label">FAQ</p><h2>{title}</h2></div>
  <div class="faq-list">
    {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </div>
</section>
