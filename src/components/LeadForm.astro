---
import { site } from '../config/site';
interface Props { title?: string; lede?: string; interest?: string; id?: string }
const { title = 'Book a <em>consultation.</em>', lede = 'For lighting, windows, gutters, siding, stone and doors. We visit in person, see the house, and send you a written plan and price. No cost, no obligation.', interest = '', id = 'request' } = Astro.props;
const services = ['Architectural and landscape lighting', 'Windows', 'Gutters', 'Siding and stone', 'Doors'];
---
<section class="lead" id={id}>
  <div class="lead-inner">
    <div class="lead-copy">
      <p class="label">Regent Exterior Services</p>
      <h2 set:html={title} />
      <p class="body">{lede}</p>
      <ul class="assure">
        <li>Licensed in Maryland, {site.license}</li>
        <li>A written scope and price before any work</li>
        <li>Serving {site.areaLine}</li>
      </ul>
    </div>
    <form class="form" name="consultation" method="POST" action="/thank-you/?type=consultation" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="consultation" />
      <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <input type="hidden" name="lead_source" data-lead-source value="" />
      <input type="hidden" name="design" data-design-field value="" />
      <div class="row">
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Email<input type="email" name="email" autocomplete="email" required /></label>
      </div>
      <div class="row">
        <label>Phone<input type="tel" name="phone" autocomplete="tel" /></label>
        <label>Town or ZIP<input name="town" autocomplete="address-level2" required /></label>
      </div>
      <div class="row">
        <label>Street address<input name="address" autocomplete="street-address" /></label>
        <label>Best time for a visit<select name="visit_time"><option>Weekday morning</option><option>Weekday afternoon</option><option>Weekday evening (to see the house after dark)</option><option>Saturday</option><option>Any time</option></select></label>
      </div>
      <fieldset>
        <legend>What are you interested in?</legend>
        <div class="checks">
          {services.map((s) => <label class="check"><input type="checkbox" name="interest" value={s} checked={s === interest} /><span>{s}</span></label>)}
        </div>
      </fieldset>
      <label>About the house<textarea name="message" rows="4" placeholder="Anything we should know: the style of the house, what you would like lit, timing."></textarea></label>
      <p class="design-summary" data-design-summary hidden></p>
      <button class="btn solid" type="submit">Request a consultation</button>
      <p class="fine">Booking holiday lights? <a href="/holiday-lighting/#estimate">Price and book them online</a>.</p>
      <p class="fine">We reply by email{site.phone ? ' or phone' : ''}, usually within one business day.</p>
    </form>
  </div>
</section>
