---
import Base from '../layouts/Base.astro';
---
<Base title="Booking confirmed | Regent Exterior Services" description="Your holiday lighting deposit has been received." noindex>
  <main id="content">
    <section class="page-intro centered">
      <p class="label">Deposit received</p>
      <h1>You're booked. <em>Thank you.</em></h1>
      <p class="body">Your receipt is on its way by email. We will be in touch within one business day to schedule a short visit, measure and confirm your final price before install.</p>
      <p><a class="btn" href="/">Back to the home page</a></p>
    </section>
  </main>
</Base>
