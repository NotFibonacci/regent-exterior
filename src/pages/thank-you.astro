---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you | Regent Exterior Services" description="Your request has been sent.">
  <main id="content">
    <section class="page-intro centered">
      <p class="label">Request received</p>
      <h1>Thank you. <em>We'll be in touch.</em></h1>
      <p class="body">We usually reply within one business day. If you asked for holiday lighting, we will confirm the measurements and your install window.</p>
      <p><a class="btn" href="/">Back to the home page</a></p>
    </section>
  </main>
</Base>
