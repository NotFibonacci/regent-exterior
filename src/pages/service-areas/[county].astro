---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import { counties, type County } from '../../data/counties';
import { site } from '../../config/site';

export function getStaticPaths() {
  return counties.map((c) => ({ params: { county: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: County };
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Exterior lighting and home exterior services', provider: { '@id': new URL('/#business', Astro.site).href }, areaServed: { '@type': 'AdministrativeArea', name: `${c.name}, Maryland` } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Service areas', item: new URL('/service-areas/', Astro.site).href }, { '@type': 'ListItem', position: 2, name: c.name, item: new URL(`/service-areas/${c.slug}/`, Astro.site).href }] },
];
---
<Base title={`Exterior lighting in ${c.name}, MD | Regent Exterior Services`} description={`Architectural, landscape and holiday lighting, plus windows, gutters, siding and doors, for homes in ${c.towns.slice(0, 4).join(', ')} and across ${c.name}. MHIC #41139.`} image="/img/lighting-full.webp" schema={schema}>
  <main id="content">
    <section class="page-intro">
      <p class="label"><a href="/service-areas/">Service areas</a> · {c.name}</p>
      <h1>Exterior lighting in <em>{c.name}.</em></h1>
      <p class="body">{c.intro}</p>
    </section>

    <section class="section prose">
      <h2>The homes here</h2>
      <p>{c.homes}</p>
      <h2>Lighting that suits them</h2>
      <p>{c.lighting}</p>
      <h2>Holiday lighting</h2>
      <p>{c.holiday} Installations start at ${site.holidayMinimum}. <a href="/holiday-lighting/#estimate">Get an instant estimate</a>.</p>
      <h2>Before you start</h2>
      <p>{c.note}</p>
    </section>

    <section class="section">
      <div class="sec-head"><p class="label">Where we work</p><h2>Towns we serve in {c.name}</h2></div>
      <ul class="towns">{c.towns.map((t) => <li>{t}</li>)}</ul>
      <p class="body small">Not listed? If you are in {c.name}, we most likely cover you. Ask.</p>
    </section>

    <section class="section">
      <div class="sec-head"><p class="label">Also in {c.name}</p><h2>Other exterior work</h2></div>
      <div class="cards">
        <a class="card link" href="/windows/"><h3>Windows</h3><p>Replacement windows matched to the house.</p></a>
        <a class="card link" href="/gutters/"><h3>Gutters</h3><p>Seamless gutters sized for the roof.</p></a>
        <a class="card link" href="/siding-and-stone/"><h3>Siding &amp; Stone</h3><p>Lap siding, shakes and stone veneer.</p></a>
        <a class="card link" href="/doors/"><h3>Doors</h3><p>Entry, storm and patio doors.</p></a>
      </div>
    </section>

    <LeadForm title={`A design visit in <em>${c.name}.</em>`} />
  </main>
</Base>
