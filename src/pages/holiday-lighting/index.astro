---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import Gallery from '../../components/Gallery.astro';
import { pricing } from '../../config/pricing';
import { site } from '../../config/site';
import { counties } from '../../data/counties';

const faqs = [
  { q: 'Is there a minimum?', a: `Yes. Holiday installations start at $${site.holidayMinimum}. Most homes price above that once the roofline is measured.` },
  { q: 'Do I own the lights?', a: 'With a Single Install the lights are yours to keep. With Seasonal Service and the Annual Plan the lights are ours: we supply, maintain, take down and store them, which is why those plans cost less.' },
  { q: 'What if a bulb goes out during the season?', a: 'Seasonal Service and Annual Plan clients get in-season maintenance: tell us and we come back and fix it.' },
  { q: 'How accurate is the online estimate?', a: 'It is a range based on what you enter. We confirm the final price on site, before install, once we have measured the roofline and seen the trees.' },
  { q: 'When should I book?', a: 'Install dates fill up through November and December. Anything scheduled inside five days is a rush install and costs more.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Holiday and Christmas light installation', provider: { '@id': new URL('/#business', Astro.site).href }, areaServed: counties.map((c) => `${c.name}, Maryland`), offers: { '@type': 'Offer', priceSpecification: { '@type': 'PriceSpecification', minPrice: site.holidayMinimum, priceCurrency: 'USD' } } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const o = pricing.offers;
const range = (from: number, to: number, step = 1) => Array.from({ length: Math.floor((to - from) / step) + 1 }, (_, i) => from + i * step);
const feet = range(50, 1000, 50);
const trees = [
  { k: 'ts', name: 'trees_small', label: 'Trees under 10 ft', max: 10 },
  { k: 'tm', name: 'trees_medium', label: 'Trees 10 to 25 ft', max: 10 },
  { k: 'sh', name: 'shrubs', label: 'Shrubs', max: 20 },
];
const addons = [
  { k: 'wr', name: 'wreaths', label: 'Wreaths', opts: range(1, 10), unit: '' },
  { k: 'wi', name: 'windows', label: 'Windows outlined', opts: range(1, 20), unit: '' },
  { k: 'ga', name: 'garland_ft', label: 'Garland', opts: range(50, 500, 50), unit: ' ft' },
];
---
<Base title="Holiday and Christmas light installation in Central Maryland | Regent Exterior Lighting" description={`Professional holiday lighting for Central Maryland homes: designed, installed, maintained and taken down. Instant estimate online. From $${site.holidayMinimum}. MHIC #41139.`} image="/img/holiday-navy.webp" schema={schema}>
  <main id="content">
    <PageHero label="Regent Holiday Lighting" title="And for <em>December.</em>" lede="Rooflines outlined straight and true, shrubs and trees dressed, all installed, maintained through the season and taken down after it." image="/img/holiday-navy.webp" alt="Navy blue house with a white wraparound porch at night, warm white bulbs along every roofline and shrubs wrapped in lights" cta={{ href: '#estimate', text: 'Get an instant estimate' }} />

    <section class="section">
      <div class="sec-head"><p class="label">Three ways to have it</p><h2>Choose <em>how you want the season.</em></h2></div>
      <div class="cards three">
        <article class="card"><h3>{o.single.label}</h3><p>{o.single.note} One visit, no takedown included.</p></article>
        <article class="card featured"><p class="tag">Most chosen</p><h3>{o.seasonal.label}</h3><p>{o.seasonal.note} One price, nothing to store.</p></article>
        <article class="card"><h3>{o.annual.label}</h3><p>{o.annual.note} The same service every year without asking.</p></article>
      </div>
    </section>

    <Gallery label="The look" title="Warm, even, <em>all season.</em>" note="Photos and renderings show styles we install." photos={[
      { src: '/img/holiday-multi.webp', alt: 'Brick-front porch at night with multicolour bulbs along the roofline and porch eave, garland on the railing and shrubs wrapped in colour', caption: 'Multicolour on the roofline, garland and shrubs, all on one plan.', w: 1337, h: 1176 },
      { src: '/img/holiday-moonlit.webp', alt: 'Two-storey house under a full moon with icicle lights along the porch eave and every shrub wrapped in warm white', caption: 'Icicle lights along the eave and every shrub wrapped to match.', w: 906, h: 670 },
      { src: '/img/holiday-bokeh.webp', alt: 'Out-of-focus multicolour holiday light displays on trees and frames at night', caption: 'Warm white, blue and white or red and green: your palette, set at the design visit.', w: 596, h: 400 },
    ]} />

    <section class="section estimator" id="estimate">
      <div class="sec-head"><p class="label">Instant estimate</p><h2>Your price, <em>in a minute.</em></h2><p class="body">Enter what you know. If you are not sure of a number, tick the box and we will measure it for you.</p></div>
      <form class="form est" name="holiday-quote" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" data-estimator>
        <input type="hidden" name="form-name" value="holiday-quote" />
        <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <input type="hidden" name="estimate" data-est-field />
        <input type="hidden" name="crew_plan" data-est-crew />
        <div class="est-grid">
          <fieldset class="est-block">
            <legend>Your home</legend>
            <label>Storeys<select name="stories" data-k="stories"><option value="1">One</option><option value="2" selected>Two</option><option value="3">Three or more</option></select></label>
            <label class="check"><input type="checkbox" name="steep" value="yes" data-k="steep" /><span>Steep roof (8/12 pitch or more)</span></label>
            <label>Roofline to light<select name="roofline_ft" data-k="roof">{feet.map((f) => <option value={f} selected={f === 150}>{f} ft</option>)}</select></label>
            <label class="check"><input type="checkbox" name="measure_for_me" value="yes" data-k="measure" /><span>I'm not sure. Measure it for me.</span></label>
          </fieldset>
          <fieldset class="est-block">
            <legend>What gets lit</legend>
            <div class="addon">
              <button type="button" class="addon-toggle" aria-expanded="false" aria-controls="addon-trees" data-addon-toggle>Trees and shrubs <span aria-hidden="true">+</span></button>
              <div class="addon-panel" id="addon-trees" hidden>
                {trees.map((t) => (
                  <div class="addon-item">
                    <label class="check"><input type="checkbox" data-on={t.k} /><span>{t.label}</span></label>
                    <select name={t.name} data-k={t.k} aria-label={`How many ${t.label.toLowerCase()}`} disabled>{range(1, t.max).map((n) => <option value={n}>{n}</option>)}</select>
                  </div>
                ))}
                <label class="check"><input type="checkbox" name="trees_large" value="yes" data-k="tl" /><span>Trees over 25 ft (quoted on site)</span></label>
              </div>
            </div>
            <div class="addon">
              <button type="button" class="addon-toggle" aria-expanded="false" aria-controls="addon-extras" data-addon-toggle>Add ons <span aria-hidden="true">+</span></button>
              <div class="addon-panel" id="addon-extras" hidden>
                {addons.map((a) => (
                  <div class="addon-item">
                    <label class="check"><input type="checkbox" data-on={a.k} /><span>{a.label}</span></label>
                    <select name={a.name} data-k={a.k} aria-label={a.k === 'ga' ? 'Linear feet of garland' : `How many ${a.label.toLowerCase()}`} disabled>{a.opts.map((n) => <option value={n}>{n}{a.unit}</option>)}</select>
                  </div>
                ))}
              </div>
            </div>
          </fieldset>
          <fieldset class="est-block">
            <legend>Your plan</legend>
            <div class="radios">
              {Object.entries(o).map(([k, v]) => <label class="check"><input type="radio" name="offer" value={v.label} data-offer={k} checked={k === 'seasonal'} /><span><strong>{v.label}</strong><br /><small>{v.note}</small></span></label>)}
            </div>
            <label>Colour<select name="colour"><option>Warm white</option><option>Cool white</option><option>Multicolour</option><option>Red and green</option><option>Blue and white</option></select></label>
            <label class="check"><input type="checkbox" name="rush" value="yes" data-k="rush" /><span>I need it installed within 5 days</span></label>
          </fieldset>
        </div>
        <div class="est-result" aria-live="polite">
          <p class="label">Estimated range</p>
          <p class="est-price" data-est-price>$0</p>
          <p class="est-note" data-est-note>Confirmed on site before install.</p>
        </div>
        <div class="row">
          <label>Name<input name="name" autocomplete="name" required /></label>
          <label>Email<input type="email" name="email" autocomplete="email" required /></label>
        </div>
        <div class="row">
          <label>Phone<input type="tel" name="phone" autocomplete="tel" /></label>
          <label>Street address<input name="address" autocomplete="street-address" required /></label>
        </div>
        <div class="row">
          <label>Town or ZIP<input name="town" autocomplete="postal-code" required /></label>
          <label>Preferred install window<select name="install_window"><option>As soon as possible</option><option>Mid November</option><option>Late November</option><option>Early December</option><option>Mid December</option></select></label>
        </div>
        <button class="btn solid" type="submit">Request this estimate</button>
        <p class="fine">Sending this reserves nothing and costs nothing. We confirm the price on site, then send a written agreement. No payment is taken before it is signed.</p>
      </form>
    </section>

    <Faq faqs={faqs} />
  </main>

  <script>
    import { estimate, type OfferKey } from '../../config/estimate';
    import { pricing } from '../../config/pricing';
    const f = document.querySelector<HTMLFormElement>('[data-estimator]');
    if (f) {
      const el = (k: string) => f.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-k="${k}"]`);
      const num = (k: string) => { const e = el(k); return !e || e.disabled ? 0 : Number(e.value) || 0; };
      const on = (k: string) => { const e = el(k) as HTMLInputElement | null; return !!e && !e.disabled && e.checked; };
      const fmt = (n: number) => '$' + (Math.round(n / 10) * 10).toLocaleString('en-US');
      const out = f.querySelector('[data-est-price]')!, note = f.querySelector('[data-est-note]')!;
      const field = f.querySelector<HTMLInputElement>('[data-est-field]')!, crewField = f.querySelector<HTMLInputElement>('[data-est-crew]')!;
      f.querySelectorAll<HTMLButtonElement>('[data-addon-toggle]').forEach((b) => b.addEventListener('click', () => {
        const open = b.getAttribute('aria-expanded') !== 'true';
        b.setAttribute('aria-expanded', String(open));
        document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !open;
        b.querySelector('span')!.textContent = open ? '\u2212' : '+';
      }));
      f.querySelectorAll<HTMLInputElement>('[data-on]').forEach((c) => c.addEventListener('change', () => {
        const s = el(c.dataset.on!)!; s.disabled = !c.checked; if (c.checked) s.focus();
      }));
      const calc = () => {
        const offer = (f.querySelector<HTMLInputElement>('[data-offer]:checked')!.dataset.offer) as OfferKey;
        const e = estimate({
          roofline: num('roof'), stories: num('stories'), steep: on('steep'),
          treesSmall: num('ts'), treesMedium: num('tm'), shrubs: num('sh'),
          wreaths: num('wr'), windows: num('wi'), garland: num('ga'), offer, rush: on('rush'),
        });
        crewField.value = e.summary;
        if (on('measure')) {
          out.textContent = 'We will measure';
          note.textContent = `We will measure the roofline on site and send your price. Installations start at ${fmt(pricing.minimum)}.`;
          field.value = 'Measure on site';
          return;
        }
        out.textContent = Math.round(e.lo) === Math.round(e.hi) ? fmt(e.lo) : `${fmt(e.lo)} to ${fmt(e.hi)}`;
        note.textContent = (offer === 'annual' ? 'Per year, held for three years. ' : '') + 'Confirmed on site before install.' + (on('tl') ? ' Large trees are added after we see them.' : '');
        field.value = `${out.textContent} (${pricing.offers[offer].label})`;
      };
      f.addEventListener('input', calc);
      f.addEventListener('change', calc);
      calc();
    }
  </script>
</Base>
