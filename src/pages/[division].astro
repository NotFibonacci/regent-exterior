---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import { divisions, type Division } from '../data/divisions';
import { counties } from '../data/counties';

export function getStaticPaths() {
  return divisions.map((d) => ({ params: { division: d.slug }, props: { d } }));
}
const { d } = Astro.props as { d: Division };
const interest = { windows: 'Windows', gutters: 'Gutters', siding: 'Siding', doors: 'Doors' }[d.slug] ?? '';
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', serviceType: d.title, provider: { '@id': new URL('/#business', Astro.site).href }, areaServed: counties.map((c) => `${c.name}, Maryland`) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href }, { '@type': 'ListItem', position: 2, name: d.brand.replace('Exterior ', ''), item: new URL(`/${d.slug}/`, Astro.site).href }] },
];
---
<Base title={`${d.title} | Regent ${d.brand}`} description={d.description} image={d.image} schema={schema}>
  <main id="content">
    <PageHero label={`Regent ${d.brand}`} title={d.h1} lede={d.lede} image={d.image} alt={d.imageAlt} />

    <section class="section">
      <div class="sec-head"><p class="label">What we do</p><h2>{d.brand.replace('Exterior ', '')}, handled by specialists.</h2></div>
      <div class="cards">
        {d.services.map((s) => <article class="card"><h3>{s.name}</h3><p>{s.text}</p></article>)}
      </div>
    </section>

    <section class="section split">
      <div class="sec-head"><p class="label">How we work</p><h2>Measured, written down, <em>done once.</em></h2></div>
      <ol class="steps">
        {d.approach.map((a) => <li>{a}</li>)}
      </ol>
    </section>

    <Faq faqs={d.faqs} />

    <section class="section areas-strip">
      <p class="label">Service areas</p>
      <p class="areas-links">{counties.map((c) => <a href={`/service-areas/${c.slug}/`}>{c.name}</a>)}</p>
    </section>

    <LeadForm interest={interest} title={`Talk to us about <em>${d.brand.replace('Exterior ', '').toLowerCase()}.</em>`} />
  </main>
</Base>
