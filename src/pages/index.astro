---
import Base from '../layouts/Base.astro';
import PhotoStage from '../scene/PhotoStage.tsx';
import { site } from '../config/site';
---
<Base
  title="Regent Exterior Services | Architectural and holiday lighting in Central Maryland"
  description="Architectural and holiday lighting, designed and installed for homes in Baltimore, Anne Arundel, Howard, Prince George's and Carroll Counties. MHIC #41139."
>
  <div id="stage" data-assets="/home/"><PhotoStage client:only="react" /></div>
  <p class="preview-note">Lighting preview on a real home. Not a completed installation.</p>

  <main id="content">
    <section class="scene" data-scene="dusk">
      <div class="copy reveal">
        <p class="label" style="--i:0">Architectural lighting · Central Maryland</p>
        <h1 style="--i:1">Your home, <em>after dark.</em></h1>
        <p class="body" style="--i:2">Lighting designed for the house you already have. Scroll, and it comes on one layer at a time.</p>
        <p class="hint" style="--i:3">Move across the house. The light is yours.</p>
      </div>
    </section>

    <section class="scene" data-scene="path">
      <div class="copy reveal">
        <p class="label" style="--i:0">One · The approach</p>
        <h2 style="--i:1">First, <em>the way in.</em></h2>
        <p class="body" style="--i:2">Low lights along the flagstones mark each step of the walk, and the porch light brings you to the door.</p>
      </div>
    </section>

    <section class="scene" data-scene="architecture">
      <div class="copy reveal">
        <p class="label" style="--i:0">Two · The architecture</p>
        <h2 style="--i:1">Then <em>the stone.</em></h2>
        <p class="body" style="--i:2">Uplights graze the walls from their base. Texture that daylight flattens comes forward, course by course.</p>
      </div>
    </section>

    <section class="scene" data-scene="eaves">
      <div class="copy reveal">
        <p class="label" style="--i:0">Three · The roofline</p>
        <h2 style="--i:1">Then <em>the shape of it.</em></h2>
        <p class="body" style="--i:2">A soft wash under the eaves holds the outline of the house against the sky.</p>
      </div>
    </section>

    <section class="scene" data-scene="holiday">
      <div class="copy reveal">
        <p class="label" style="--i:0">Four · The season</p>
        <h2 style="--i:1">And for <em>December.</em></h2>
        <p class="body" style="--i:2">Roofline and gable lighting, installed, maintained through the season and taken down after it. From ${site.holidayMinimum}.</p>
        <p style="--i:3"><a class="btn" href={`mailto:${site.email}?subject=Holiday%20lighting`}>Ask about holiday lighting</a></p>
      </div>
    </section>
  </main>

  <footer class="closing">
    <div class="inner">
      <p class="label">Regent Exterior Lighting</p>
      <h2>Begin with <em>a design visit.</em></h2>
      <p class="body">Tell us about the house. We come out, see it in person, and give you a plan and a price.</p>
      <p><a class="btn" href={`mailto:${site.email}?subject=Lighting%20design%20visit`}>Request a design visit</a></p>
      <ul class="areas" aria-label="Counties served">
        {site.counties.map((c) => <li>{c} County</li>)}
      </ul>
      <div class="legal">
        <span>{site.name}</span>
        <span>Licensed in Maryland · {site.license}</span>
      </div>
    </div>
  </footer>
</Base>
